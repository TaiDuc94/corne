#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BASE";

            bindings = <
&kp ESCAPE     &kp Q  &kp W  &kp E         &kp R     &kp T        &kp Y    &kp U        &kp I       &kp O    &kp P     &kp BSPC
&mt LCTRL TAB  &kp A  &kp S  &kp D         &kp F     &kp G        &kp H    &kp J        &kp K       &kp L    &kp SEMI  &kp SQT
&kp LSHFT      &kp Z  &kp X  &kp C         &kp V     &kp B        &kp N    &kp M        &kp COMMA   &kp DOT  &kp FSLH  &kp DEL
                   &tog 3 &kp LEFT_ALT  &kp LGUI  &kp SPACE       &kp RET  &lt 1 SPACE  &lt 2 CAPS &kp K_MUTE
            >;

            sensor-bindings = <&inc_dec_kp LEFT_BRACKET RIGHT_BRACKET &inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        lower_layer {
            display-name = "NUMB";

            bindings = <
&trans    &kp N1  &kp N2  &kp N3    &kp N4    &kp N5       &trans   &trans    &kp UP    &trans     &trans  &trans
&trans    &kp N6  &kp N7  &kp N8    &kp N9    &kp N0       &trans   &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans
&trans  &trans  &trans  &trans    &trans    &trans       &trans   &trans    &trans    &trans     &trans  &trans
                 &trans &trans  &trans  &trans       &trans  &trans    &trans &trans
            >;

            sensor-bindings = <&inc_dec_kp PG_DN PG_UP &inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        raise_layer {
            display-name = "SPBT";

            bindings = <
&trans  &kp EXCL    &kp AT        &kp HASH      &kp DLLR      &kp PRCNT      &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR  &kp BSPC
&trans     &trans      &trans        &trans        &trans        &trans         &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT  &kp BSLH  &kp GRAVE
&trans   &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3    &kp UNDER  &kp PLUS   &kp LBRC   &kp RBRC  &kp PIPE  &kp TILDE
                            &trans    &trans      &trans      &trans         &trans  &trans    &trans &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_DN C_VOL_UP>;
        };
Photoshop_layer {
            display-name = "PTS!";

            bindings = <
&kp ESCAPE     &kp Q  &kp W  &kp E         &kp R     &kp T        &kp Y    &kp U        &kp I       &kp O    &kp P     &kp BSPC
&mt LCTRL TAB  &kp A  &kp S  &kp D         &kp F     &kp G        &kp H    &kp J        &kp K       &kp L    &kp SEMI  &kp SQT
&kp LSHFT      &kp Z  &kp X  &kp C         &kp V     &kp B        &kp N    &kp M        &kp COMMA   &kp DOT  &kp FSLH  &kp DEL
                   &tog 3 &kp LEFT_ALT  &kp LGUI  &kp SPACE       &kp RET  &lt 1 SPACE  &lt 2 CAPS &kp K_MUTE
            >;

            sensor-bindings = <&inc_dec_kp LEFT_ARROW RIGHT_ARROW &inc_dec_kp C_VOL_DN C_VOL_UP>;
        };
    };
};
